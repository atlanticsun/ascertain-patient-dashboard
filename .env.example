# Copy this file to .env and adjust values for local development.

# Postgres credentials used by docker compose and the API
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dashboard

# SQLAlchemy URL the API uses to reach Postgres.
# Inside docker compose the host is "db". Outside docker use localhost.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/dashboard

# Public URL of the API. Baked into the frontend at build time.
VITE_API_URL=http://localhost:8000
